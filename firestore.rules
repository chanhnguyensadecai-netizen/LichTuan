rules_version = '2';

// ==========================================================================
// LƯU Ý QUAN TRỌNG:
// File firestore.rules trước đây trong repo đã bị lỗi - nội dung bên trong
// thực ra là code của component AttachmentManager.tsx (dán nhầm file), nên
// không phải là security rules hợp lệ. Vì vậy mỗi lần deploy rules đều thất
// bại và Firebase vẫn chạy bộ rules CŨ (không hiểu field "status" mới) -
// đây chính là lý do lịch admin vừa thêm/sửa không hiển thị cho user khác,
// trong khi lịch cũ vẫn xem bình thường.
//
// File này được viết lại dựa theo đúng cấu trúc dữ liệu hiện tại của app
// (xem src/types.ts, src/App.tsx, src/components/*.tsx).
// SAU KHI PUSH FILE NÀY LÊN GITHUB, BẠN VẪN PHẢI DEPLOY THỦ CÔNG LÊN FIREBASE
// (xem hướng dẫn cuối chat) - Vercel/GitHub KHÔNG tự deploy Firestore rules.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Lấy role của người dùng đang đăng nhập từ document users/{uid}
    function userRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isElevated() {
      // admin / office / leader: được tự động duyệt lịch, quản lý tài liệu...
      return isSignedIn() && userRole() in ['admin', 'office', 'leader'];
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    // ---------------- users (hồ sơ & phân quyền tài khoản) ----------------
    match /users/{userId} {
      // Cho phép đọc khi đã đăng nhập (dùng để đối chiếu quyền, danh sách quản trị...)
      allow read: if isSignedIn();

      // Tạo mới: chính chủ tự tạo hồ sơ của mình (đăng nhập lần đầu),
      // hoặc admin tạo tài khoản "chờ kích hoạt" (dùng email làm id tạm)
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Cập nhật: chính chủ (vd cập nhật lastLogin) hoặc admin (đổi quyền)
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Xóa: admin, hoặc chính người dùng xóa hồ sơ "chờ kích hoạt" trùng email của mình
      // (xem App.tsx - xóa preAuthDoc sau khi đã tạo hồ sơ thật theo uid)
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    // ---------------- schedules (lịch công tác) ----------------
    match /schedules/{scheduleId} {
      // Đọc công khai: app có màn "Lịch công tác tuần" cho khách chưa đăng nhập xem
      allow read: if true;

      // Tạo lịch: chỉ cần đăng nhập (vai trò thường -> lưu ở trạng thái "pending")
      allow create: if isSignedIn();

      // Sửa/xóa: admin/office/leader sửa được mọi lịch, người tạo sửa được lịch của mình
      allow update, delete: if isElevated() ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------- attachments (tài liệu đính kèm - dạng link) ----------------
    match /attachments/{attachmentId} {
      allow read: if true;
      allow create: if isElevated();
      allow update, delete: if isElevated();
    }

    // ---------------- settings (cấu hình hệ thống chung) ----------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
