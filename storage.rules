rules_version = '2';

// ==========================================================================
// LƯU Ý: File storage.rules trước đây trong repo cũng bị lỗi tương tự
// firestore.rules - nội dung bên trong là code AttachmentManager.tsx bị dán
// nhầm, không phải rules hợp lệ, nên không deploy được.
//
// Qua kiểm tra code (src/), app hiện KHÔNG dùng Firebase Storage SDK -
// phần "tài liệu đính kèm" chỉ lưu link Google Drive trong Firestore
// (collection "attachments"), field storagePath luôn để trống.
// Vì vậy rules dưới đây chỉ cần khóa an toàn mặc định: chỉ người dùng đã
// đăng nhập mới đọc/ghi được, tránh để trống hoàn toàn (public read/write)
// gây rủi ro bảo mật nếu sau này có dùng Storage thật.
// ==========================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
